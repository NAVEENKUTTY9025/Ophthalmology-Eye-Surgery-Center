<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <!-- Background Luxury Burgundy Gradient -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#9B2C3B"/>
      <stop offset="50%" stop-color="#8B2635"/>
      <stop offset="100%" stop-color="#5E1420"/>
    </linearGradient>

    <!-- Warm Gold Gradient for border and surgical accents -->
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E5C158"/>
      <stop offset="50%" stop-color="#C49A38"/>
      <stop offset="100%" stop-color="#9A7520"/>
    </linearGradient>

    <!-- Optical Iris Gradient (Sapphire Blue to Deep Navy) -->
    <radialGradient id="irisGrad" cx="35%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#38BDF8"/>
      <stop offset="35%" stop-color="#0284C7"/>
      <stop offset="75%" stop-color="#0369A1"/>
      <stop offset="100%" stop-color="#0C4A6E"/>
    </radialGradient>

    <!-- Cornea / Lens Glow -->
    <radialGradient id="lensGlow" cx="32" cy="32" r="24" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"/>
    </radialGradient>

    <!-- Subtle Drop Shadow -->
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="2" stdDeviation="1.5" flood-color="#000000" flood-opacity="0.35"/>
    </filter>
  </defs>

  <!-- Base Badge: Squircle container for universal dark/light tab contrast -->
  <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#bgGrad)" stroke="url(#goldGrad)" stroke-width="1.5"/>

  <!-- Subtle inner lens glow -->
  <rect x="3" y="3" width="58" height="58" rx="15" fill="url(#lensGlow)"/>

  <!-- Medical / Surgical Crosshair Guides (Subtle Precision Marks at 4 Cardinal Points) -->
  <g stroke="url(#goldGrad)" stroke-width="1.5" stroke-linecap="round" opacity="0.85">
    <!-- Top guide -->
    <line x1="32" y1="6" x2="32" y2="10"/>
    <!-- Bottom guide -->
    <line x1="32" y1="54" x2="32" y2="58"/>
    <!-- Left guide -->
    <line x1="6" y1="32" x2="10" y2="32"/>
    <!-- Right guide -->
    <line x1="54" y1="32" x2="58" y2="32"/>
  </g>

  <!-- Eye Sclera / Cornea Shape (Crisp White Almond with soft shadow) -->
  <path d="M 8 32 C 16 17, 48 17, 56 32 C 48 47, 16 47, 8 32 Z" 
        fill="#FFFFFF" 
        filter="url(#shadow)"/>

  <!-- Iris (Optical Eye Health & Vision Clarity) -->
  <circle cx="32" cy="32" r="11" fill="url(#irisGrad)"/>

  <!-- Fine Iris Ring / Limbal Ring -->
  <circle cx="32" cy="32" r="11" fill="none" stroke="#075985" stroke-width="0.8" opacity="0.6"/>

  <!-- Pupil (Dark Central Aperture) -->
  <circle cx="32" cy="32" r="5.2" fill="#020617"/>

  <!-- Surgical Precision Laser Cross / Crosshair inside Iris -->
  <g stroke="#38BDF8" stroke-width="0.75" opacity="0.7" stroke-linecap="round">
    <line x1="32" y1="22" x2="32" y2="25"/>
    <line x1="32" y1="39" x2="32" y2="42"/>
    <line x1="22" y1="32" x2="25" y2="32"/>
    <line x1="39" y1="32" x2="42" y2="32"/>
  </g>

  <!-- Corneal Light Reflection / Specular Highlight (Life & Clarity Sparkle) -->
  <circle cx="35.5" cy="28.5" r="2.2" fill="#FFFFFF"/>
  <circle cx="29" cy="34.5" r="1" fill="#FFFFFF" opacity="0.7"/>

  <!-- Surgical Precision Star / Sparkle in Top-Right of Badge -->
  <path d="M 47 13 Q 48.5 15.5 51 17 Q 48.5 18.5 47 21 Q 45.5 18.5 43 17 Q 45.5 15.5 47 13 Z" fill="url(#goldGrad)" opacity="0.9"/>
</svg>